#, python-brace-format
msgid "Image {filename} with image unique ID {image_unique_id} already exists."
msgstr "Image {filename} avec ID d'image unique {image_unique_id} déjà existant."

#: src/npo/core/constants.py:41
msgid "File size exceeds the maximum allowed limit."
msgstr "Taille de fichier dépassant la limite autorisée."

#: src/npo/core/constants.py:42
msgid "There was an error uploading the file."
msgstr "Une erreur est survenue lors du téléversement du fichier."

