#: src/npo/modules/images/routes.py:90
msgid ""
"Retrieves the list of stored images with pagination. Returns basic metadata "
"(hash, name, date, location)."
msgstr ""
"Retourner la liste des images stockées avec une pagination. Retourne les "
"métadonnées basiques (hash, nom, date, localisation)."

#: src/npo/modules/images/routes.py:93
msgid "List of images and pagination information"
msgstr "Liste des images et information de pagination"

#: src/npo/modules/images/routes.py:118
msgid "Upload image files"
msgstr "Fichiers d'image téléversés"

#: src/npo/modules/images/routes.py:120
msgid ""
"Upload one or more images. The system automatically calculates hashes, extracts "
"EXIF metadata, and generates tiles for Deep Zoom."
msgstr ""
"Téléverse une ou plusieurs images. Le système calcule automatiquement les hashs, "
"extraits les métadonnées EXIF et génère des tuiles pour un zoom haute résolution."

#: src/npo/modules/images/routes.py:124
msgid "Dictionary of processed files with their information"
msgstr "Dictionnaire des fichiers traités avec leur information."

#: src/npo/modules/images/routes.py:127
msgid "Duplicate image (perceptual hash or unique ID already exists)"
msgstr "Image dupliquée (le hash perceptuel ou l'ID d'image unique existe déjà)."

#: src/npo/modules/images/routes.py:128
msgid "File too large"
msgstr "Fichier trop volumineux"

#: src/npo/modules/images/routes.py:129
msgid "Insufficient storage space"
msgstr "Espace de stockage insuffisant"

#: src/npo/modules/images/routes.py:130
msgid "Image decoding or processing error"
msgstr "Erreur de décodage ou de traitement de l'image"

#: src/npo/modules/images/routes.py:169
msgid "Get tile image by pixel hash, zoom level and coordinates"
msgstr ""
"Obtenir la tuile de l'image à l'aide de son hash de pixels, du niveau de zoom et "
"des coordonnées"

#: src/npo/modules/images/routes.py:170
msgid "Retrieves a specific tile (JPEG format) for Deep Zoom display."
msgstr ""
"Récupère une tuile spécifique (format JPEG) pour l'affichage avec un zoom haute "
"résolution."

#: src/npo/modules/images/routes.py:172
msgid "JPEG image tile"
msgstr "Tuile image JPEG"

#: src/npo/modules/images/routes.py:173
#, python-brace-format
