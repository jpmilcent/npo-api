msgstr "Image ou tuile introuvable."

#: src/npo/modules/images/routes.py:203
msgid "Get file image by pixel hash"
msgstr "Obtenir le fichier image à l'aide d'un hash des pixels"

#: src/npo/modules/images/routes.py:204
msgid "Retrieves the full original image or its preview."
msgstr "Récupère l'image originale complète ou son aperçu."

#: src/npo/modules/images/routes.py:208
msgid "Image file"
msgstr "Fichier image"

#: src/npo/modules/images/routes.py:237
#, python-brace-format
msgid "Raw metadata by pixel hash"
msgstr "Métadonnées brutes en fonction du hash des pixels"

#: src/npo/modules/images/routes.py:238
msgid "Returns all raw metadata (EXIF, XMP, etc.) extracted from the file."
msgstr ""
"Retourne toutes les métadonnées brutes (EXIF, XMP, etc.) extrait du fichier."

#: src/npo/modules/images/routes.py:255
#, python-brace-format
