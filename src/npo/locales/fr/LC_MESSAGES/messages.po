#, python-brace-format
msgid "Unable to decode image file {filename}."
msgstr "Incapable de décoder le fichier image {filename}."

#: src/npo/core/constants.py:44
#, python-brace-format
msgid "Image {pixel_hash} not found."
msgstr "Image avec le pixel hash {pixel_hash} introuvable."

