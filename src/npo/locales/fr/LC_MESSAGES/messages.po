#: src/npo/core/constants.py:30
#, fuzzy, python-brace-format
msgid "Image {filename} with perceptual hash {perceptual_hash} already exists."
msgstr "Image {file_name} avec hash perceptuel {hash} déjà existant."

#: src/npo/core/constants.py:34
#, fuzzy, python-brace-format
msgid "Image {filename} with image unique ID {image_unique_id} already exists."
msgstr "Image {file_name} avec ID d'image unique {image_unique_id} déjà existant."

#: src/npo/core/constants.py:36
msgid "File size exceeds the maximum allowed limit."
msgstr "Taille de fichier dépassant la limite autorisée."

#: src/npo/core/constants.py:37
msgid "There was an error uploading the file."
msgstr "Une erreur est survenue lors du téléversement du fichier."

#: src/npo/core/constants.py:38
#, python-brace-format
msgid "Unable to decode image file {filename}."
msgstr "Incapable de décoder le fichier image {filename}."

#: src/npo/core/constants.py:39
#, python-brace-format
msgid "Image {pixel_hash} not found."
msgstr "Image avec le pixel hash {pixel_hash} introuvable."

#: src/npo/core/constants.py:42
#, python-brace-format
msgid "Unable to process image file {filename} for perceptual hashing."
msgstr "Incapable de traiter le fichier image {filename} pour le hashage perceptuel."

#: src/npo/core/constants.py:46
#, python-brace-format
msgid "Webservice /images/{path} requested not found."
msgstr "Webservice /images/{path} demandé introuvable."

#: src/npo/core/constants.py:50
msgid "Not enough disk space to save the file."
msgstr "Pas assez d'espace de stockage pour sauvegarder le fichier."

#: src/npo/core/constants.py:54
#, python-brace-format
msgid "Raw metadata for file {pixel_hash} not found."
msgstr "Métadonnées brutes du fichier avec le pixel hash {pixel_hash} introuvable."

#: src/npo/core/constants.py:58
#, python-brace-format
msgid "Photography metadata for file {pixel_hash} not found."
msgstr "Métadonnées de photographie du fichier avec le pixel hash {pixel_hash} introuvable."

#: src/npo/core/constants.py:62
#, python-brace-format
msgid "Webservice /settings/{path} requested not found."
msgstr "Webservice /settings/{path} demandé introuvable."

#: src/npo/core/constants.py:67
#, python-brace-format
msgid ""
"The application version could not be determined for package "
"'{package_name}'. Check if the package is installed."
msgstr "La version de l'application ne peut pas être déterminée pour le paquet "
"'{package_name}'. Vérifiez si le paquet est installé.

#: src/npo/core/constants.py:74
#, python-brace-format
msgid ""
"Image {filename} has unsupported GPS Map Datum: {gps_datum}. Only WGS-84 "
"is supported."
msgstr "Image {filename} avec un datum GPS non pris en charge : {gps_datum}. "
"Seul le datum WGS-84 est pris en charge.

