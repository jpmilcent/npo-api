#, python-brace-format
msgid "Webservice /images/{path} requested not found."
msgstr "Webservice /images/{path} demandé introuvable."

#: src/npo/core/constants.py:59
msgid "Not enough disk space to save the file."
msgstr "Pas assez d'espace de stockage pour sauvegarder le fichier."

#: src/npo/core/constants.py:63
#, python-brace-format
msgid "Raw metadata for file {pixel_hash} not found."
msgstr "Métadonnées brutes du fichier avec le pixel hash {pixel_hash} introuvable."

#: src/npo/core/constants.py:67
#, python-brace-format
msgid "Photography metadata for file {pixel_hash} not found."
msgstr ""
"Métadonnées de photographie du fichier avec le pixel hash {pixel_hash} "
"introuvable."

#: src/npo/core/constants.py:71
#, python-brace-format
msgid "Webservice /settings/{path} requested not found."
msgstr "Webservice /settings/{path} demandé introuvable."

#: src/npo/core/constants.py:76
#, python-brace-format
msgid ""
"The application version could not be determined for package '{package_name}'. "
"Check if the package is installed."
msgstr ""
"La version de l'application ne peut pas être déterminée pour le paquet "
"'{package_name}'. Vérifiez si le paquet est installé."

#: src/npo/core/constants.py:83
#, python-brace-format
msgid ""
"Image {filename} has unsupported GPS Map Datum: {gps_datum}. Only WGS-84 is "
"supported."
msgstr ""
"Image {filename} avec un datum GPS non pris en charge : {gps_datum}. Seul le "
"datum WGS-84 est pris en charge."

