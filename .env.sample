# Common
# API name [optional]
NPO_APP_NAME="NPO REST API"
# Code name for the application, used for directories and filenames [optional]
NPO_APP_CODE="npo"
# API environment: production (default), development, test [optional]
NPO_ENVIRONMENT="development"
# Default language code
NPO_DEFAULT_LANGUAGE="en"

# Backend
# Admin email address
NPO_ADMIN_EMAIL="me@example.com"

# Config Database
# Database connection URI
NPO_DATABASE_URI="sqlite+aiosqlite:////home/me/workspace/npo-api/data/db/file.db"
# Number of connections to keep open in the pool
NPO_DB_POOL_SIZE=5
# Number of connections to allow beyond pool_size
NPO_DB_MAX_OVERFLOW=10
# Seconds to wait for a connection from the pool
NPO_DB_POOL_TIMEOUT=30
# Seconds after which a connection is automatically recycled
NPO_DB_POOL_RECYCLE=3600
# Whether to test connections (ping) before using them
NPO_DB_POOL_PRE_PING=True

# Uploads managment
# Directory for temporary file uploads
NPO_UPLOADS_DIR="/home/me/workspace/npo-api/data/uploads/"
# Storage directory for images
NPO_STORAGE_DIR="/home/me/workspace/npo-api/data/images/"
# Number of parts to split the hash into for directory structure [optional]
# NPO_HASH_DIR_PARTS_COUNT=6
# Number of characters per part of the hash [optional]
# NPO_HASH_DIR_STEP=2
# Safety buffer size for uploads in bytes. Default: 50 MB.
NPO_UPLOAD_SAFETY_BUFFER=52428800
# Maximum allowed upload size in bytes. Default: 500 MB.
NPO_MAX_UPLOAD_SIZE=524288000

# Log managment
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
NPO_LOG_LEVEL="INFO"
# Directory where log files are stored
NPO_LOGS_DIR="logs"
# Maximum size of a log file in bytes. Default: 10 MB.
NPO_LOG_MAX_BYTES=10485760
# Number of backup log files to keep
NPO_LOG_BACKUP_COUNT=5

# CORS Configuration
# Allow Angular dev server (port 4200)
NPO_CORS_ORIGINS='["http://localhost:4200", "http://127.0.0.1:4200"]'
# Indicate that cookies should be supported for cross-origin requests
NPO_CORS_ALLOW_CREDENTIALS=True
# List of allowed HTTP methods for CORS requests
NPO_CORS_ALLOW_METHODS='["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD"]'
# List of allowed HTTP headers for CORS requests
NPO_CORS_ALLOW_HEADERS='["Content-Type", "Authorization", "Accept", "Origin", "X-Requested-With", "Accept-Language"]'
# List of response headers exposed to the browser
NPO_CORS_EXPOSE_HEADERS='["X-Request-ID", "X-Response-Time"]'

# JWT Managment
# Secret key for JWT token generation. Generate with: `openssl rand -hex 32`
NPO_JWT_SECRET_KEY="secret"
# Algorithm used for JWT encoding
NPO_JWT_ALGORITHM="HS256"
# JSON Web Token expiration time in minutes (default 30 minutes)
NPO_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh Token expiration time in minutes (default 7 days)
NPO_JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Authentication managment
# Minimum length for passwords
NPO_PASSWORD_MIN_LENGTH=8
# Google OAuth2 Client ID
NPO_GOOGLE_CLIENT_ID=""
# Google OAuth2 Client Secret
NPO_GOOGLE_CLIENT_SECRET=""
# Github OAuth2 Client ID
NPO_GITHUB_CLIENT_ID=""
# Github OAuth2 Client Secret
NPO_GITHUB_CLIENT_SECRET=""

# Frontend
# Maximum zoom level for image tiles [optional]
NPO_ZOOM_MAX=3
# Length of the partial hash used for quick matching [optional]
NPO_HASH_PARTIAL_MATCH_LENGTH=6
